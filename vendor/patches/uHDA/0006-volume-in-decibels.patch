+/*
+ * Gets the range the volume of the path can be set in.
+ */
+UhdaStatus uhda_path_get_volume_range(const UhdaPath* path, UhdaVolumeRange* res);
+
+/*
+ * Sets the volume on the path to `volume` in hundredths of a decibel.
+ *
+ * Note: the volume is rounded to the nearest step and clamped to the path's volume range.
+ */
+UhdaStatus uhda_path_set_volume_db(UhdaPath* path, int32_t volume);
