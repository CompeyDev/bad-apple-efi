+static UhdaVolumeRange get_volume_range(uint32_t amp_caps) {
+	int32_t offset = amp_caps & 0x7F;
+	int32_t num_steps = amp_caps >> 8 & 0x7F;
+	// step size is in 0.25 dB units, minus one
+	int32_t step = ((amp_caps >> 16 & 0x7F) + 1) * 25;
+
+	return {
+		.min_cdb = -offset * step,
+		.max_cdb = (num_steps - offset) * step,
+		.step_cdb = static_cast<uint32_t>(step)
+	};
+}
+
+UhdaStatus uhda_path_get_volume_range(const UhdaPath* path, UhdaVolumeRange* res) {
+	auto output = path->widgets.back();
+	if (output->type != widget_type::AUDIO_OUT) {
+		return UHDA_STATUS_UNSUPPORTED;
+	}
+
+	*res = get_volume_range(output->out_amp_caps);
+	return UHDA_STATUS_SUCCESS;
+}
+
+UhdaStatus uhda_path_set_volume_db(UhdaPath* path, int32_t volume) {
+	auto output = path->widgets.back();
+	if (output->type != widget_type::AUDIO_OUT) {
+		return UHDA_STATUS_UNSUPPORTED;
+	}
+
+	auto range = get_volume_range(output->out_amp_caps);
+	if (volume < range.min_cdb) {
+		volume = range.min_cdb;
+	}
+	else if (volume > range.max_cdb) {
+		volume = range.max_cdb;
+	}
+
+	// round to the nearest step
+	auto step = static_cast<int32_t>(range.step_cdb);
+	uint8_t value = (volume - range.min_cdb + step / 2) / step;
+
+	path->gain = value;
+
+	// set output amp, set left amp, set right amp and gain
+	uint16_t amp_data = 1 << 15 | 1 << 13 | 1 << 12 | value;
+	return path->codec->set_amp_gain_mute(output->nid, amp_data);
+}
